# 留空即可使用明确标记的演示模式。
# 本地或远端服务需提供兼容 Chat Completions 的 /chat/completions 接口。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# 若本地模型服务无需密钥，显式设置 true。
LLM_ALLOW_NO_KEY=false
LLM_MAX_OUTPUT_TOKENS=1800
# 部分模型要求 max_completion_tokens；默认使用 max_tokens。
LLM_TOKEN_PARAMETER=max_tokens
LLM_CONTEXT_CHARS=18000
LLM_TIMEOUT_MS=90000
API_PORT=8787
