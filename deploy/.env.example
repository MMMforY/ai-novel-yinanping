LLM_ALLOW_NO_KEY=false
LLM_CONTEXT_CHARS=18000
LLM_MAX_OUTPUT_TOKENS=1800
LLM_TIMEOUT_MS=90000
LLM_TOKEN_PARAMETER=max_tokens
